datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String          @id @default(uuid())
  email              String          @unique
  passwordHash       String
  username           String
  level              Int             @default(1)
  currentXp          Int             @default(0)
  currentGold        Int             @default(50)
  lifetimeGold       Int             @default(50)
  streakCount        Int             @default(0)
  lastCompletionDate DateTime?
  streakFreezeCount  Int             @default(1)
  unspentStatPoints  Int             @default(0)
  activeTheme        String          @default("CYBERPUNK")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  attributes         Attributes?
  quests             Quest[]
  inventory          InventoryItem[]
  customRewards      CustomReward[]
  auditLogs          AuditLog[]
}

model Attributes {
  id        String   @id @default(uuid())
  userId    String   @unique
  intellect Int      @default(10)
  strength  Int      @default(10)
  vitality  Int      @default(10)
  charisma  Int      @default(10)
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Quest {
  id              String    @id @default(uuid())
  userId          String
  title           String
  description     String?
  difficulty      String    @default("MEDIUM") // TRIVIAL, EASY, MEDIUM, HARD, EPIC
  targetAttribute String    @default("INTELLECT") // INTELLECT, STRENGTH, VITALITY, CHARISMA
  rewardXp        Int       @default(100)
  rewardGold      Int       @default(50)
  status          String    @default("PENDING") // PENDING, COMPLETED, ARCHIVED
  recurrence      String    @default("DAILY") // ONE_TIME, DAILY, WEEKLY
  dueDate         DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InventoryItem {
  id          String   @id @default(uuid())
  userId      String
  itemKey     String
  name        String
  category    String   // THEME, GEAR, CONSUMABLE, BADGE
  isEquipped  Boolean  @default(false)
  acquiredAt  DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemKey])
}

model CustomReward {
  id            String   @id @default(uuid())
  userId        String
  title         String
  description   String?
  cost          Int      @default(100)
  icon          String   @default("Gift")
  timesRedeemed Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  actionType String   // QUEST_COMPLETED, LEVEL_UP, ITEM_PURCHASED, REWARD_REDEEMED, STREAK_PROTECTED, STREAK_RESET, STATS_ALLOCATED
  xpDelta    Int?
  goldDelta  Int?
  details    String?  // JSON stringified metadata
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
