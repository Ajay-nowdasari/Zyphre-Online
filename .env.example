# Life RPG Root Environment Configuration Example

# Backend API Configuration
PORT=5000
NODE_ENV=production
# For PostgreSQL (Production):
DATABASE_URL="postgresql://user:password@hostname:5432/liferpg_db?schema=public"
# For SQLite (Local zero-config):
# DATABASE_URL="file:./dev.db"

JWT_SECRET="your-secure-jwt-secret-min-32-chars"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="https://your-frontend-deployment.vercel.app"

# Frontend Configuration
NEXT_PUBLIC_API_URL="https://your-backend-api.onrender.com"
BACKEND_INTERNAL_URL="http://localhost:5000/api/:path*"
